# MongoDB
MONGODB_URI=mongodb://localhost:27017/to-high

# JWT
JWT_SECRET=your-jwt-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# AI budget: exactly one owner internal user ID, never an email address.
TO_HIGH_BUDGET_ADMIN_USER_IDS=
AI_BUDGET_KRW_PER_USD=1500
# Budget alert recipient and Gmail app credentials are configured server-side.
BUDGET_ALERT_RECIPIENT=
# Fine-grained GitHub token for issues on fullth/to-high only.
INCIDENT_GITHUB_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Toss Payments
TOSS_SECRET_KEY=your-toss-secret-key

# Sentry
SENTRY_DSN=your-sentry-dsn
# Server-only numeric chat metrics. No counseling text, replay, traces or error payloads.
SENTRY_METRICS_ENABLED=false

# App
PORT=3000
ENABLE_PAYMENT_SERVICE=false
FRONTEND_URL=http://localhost:3001
